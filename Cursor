public class Cursor {
    private int x;
    private int y;
    private String type; // "горизонтальный" или "вертикальный"
    private int size;    // 1-15
    private boolean visible;

    // Конструктор без аргументов
    public Cursor() {
        this.x = 0;
        this.y = 0;
        this.type = "горизонтальный";
        this.size = 1;
        this.visible = true;
    }

    // Конструктор инициализации
    public Cursor(int x, int y, String type, int size) {
        if (x < 0 || y < 0) {
            throw new IllegalArgumentException("Координаты должны быть положительными.");
        }
        if (!type.equals("горизонтальный") && !type.equals("вертикальный")) {
            throw new IllegalArgumentException("Тип курсора должен быть 'горизонтальный' или 'вертикальный'.");
        }
        if (size < 1 || size > 15) {
            throw new IllegalArgumentException("Размер курсора должен быть от 1 до 15.");
        }
        this.x = x;
        this.y = y;
        this.type = type;
        this.size = size;
        this.visible = true;
    }

    // Методы изменения координат
    public void move(int newX, int newY) {
        if (newX >= 0 && newY >= 0) {
            this.x = newX;
            this.y = newY;
        }
    }

    // Изменение типа
    public void changeType(String newType) {
        if (newType.equals("горизонтальный") || newType.equals("вертикальный")) {
            this.type = newType;
        }
    }

    // Изменение размера
    public void changeSize(int newSize) {
        if (newSize >= 1 && newSize <= 15) {
            this.size = newSize;
        }
    }

    // Гашение и восстановление
    public void hide() { this.visible = false; }
    public void show() { this.visible = true; }

    // Отображение состояния
    public void display() { System.out.println(this.toString()); }

    @Override
    public String toString() {
        return "Cursor [x=" + x + ", y=" + y + ", type=" + type + ", size=" + size + ", visible=" + visible + "]";
    }
}
