import java.util.Arrays;

public class DynamicArray<T extends Comparable<T>> {

    private T[] data;
    private int size;

    "unchecked"
    public DynamicArray() {
        data = (T[]) new Comparable[10];
        size = 0;
    }

    // увеличение массива
    "unchecked"
    private void resize() {
        data = Arrays.copyOf(data, data.length * 2);
    }

    // добавление элемента
    public void add(T value) {
        if (size == data.length) resize();
        data[size++] = value;
    }

    // получение элемента
    public T get(int index) {
        if (index < 0 || index >= size) {
            System.out.println("Ошибка индекса");
            System.exit(1);
        }
        return data[index];
    }

    // удаление элемента
    public void remove(int index) {
        if (index < 0 || index >= size) {
            System.out.println("Ошибка индекса");
            System.exit(1);
        }

        for (int i = index; i < size - 1; i++)
            data[i] = data[i + 1];

        size--;
    }

    // поиск элемента
    public int search(T value) {
        for (int i = 0; i < size; i++)
            if (data[i].compareTo(value) == 0)
                return i;
        return -1;
    }

    // публичный запуск быстрой сортировки
    public void quickSort() {
        quickSort(0, size - 1);
    }

    // QuickSort
    private void quickSort(int left, int right) {
        if (left >= right) return;

        int i = left, j = right;
        T pivot = data[(left + right) / 2];

        while (i <= j) {
            while (data[i].compareTo(pivot) < 0) i++;
            while (data[j].compareTo(pivot) > 0) j--;

            if (i <= j) {
                swap(i, j);
                i++;
                j--;
            }
        }

        quickSort(left, j);
        quickSort(i, right);
    }

    private void swap(int i, int j) {
        T temp = data[i];
        data[i] = data[j];
        data[j] = temp;
    }

    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder("[ ");
        for (int i = 0; i < size; i++)
            sb.append(data[i]).append(" ");
        sb.append("]");
        return sb.toString();
    }
}
